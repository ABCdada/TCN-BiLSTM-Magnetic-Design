{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reproducible-example-manifest.schema.json",
  "title": "TCN-BiLSTM reproducible example manifest",
  "type": "object",
  "required": [
    "format_version",
    "artifact_class",
    "claim_scope",
    "generator",
    "environment",
    "checkpoint_manifest_sha256",
    "cases"
  ],
  "properties": {
    "format_version": {"const": 1},
    "artifact_class": {"const": "synthetic_software_verification"},
    "claim_scope": {
      "type": "object",
      "required": ["measured_data", "accuracy_claims_permitted", "statement"],
      "properties": {
        "measured_data": {"const": false},
        "accuracy_claims_permitted": {"const": false},
        "statement": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "generator": {"type": "object"},
    "environment": {"type": "object"},
    "checkpoint_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "kind",
          "input",
          "output",
          "input_sha256",
          "output_sha256",
          "timeseries_csv",
          "timeseries_csv_sha256",
          "inference_completed",
          "finite_output"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["window_prediction", "converter_pipeline"]},
          "input": {"type": "string"},
          "output": {"type": "string"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "timeseries_csv": {"type": "string"},
          "timeseries_csv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "inference_completed": {"type": "boolean"},
          "finite_output": {"type": "boolean"}
        }
      }
    }
  },
  "additionalProperties": false
}
