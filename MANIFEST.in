include README.md README_zh-CN.md API.md DEPLOYMENT.md TESTING.md
include RELEASE_NOTES.md GITHUB_UPLOAD_CHECKLIST.md MODEL_WEIGHTS_NOTICE.md
include LICENSE CITATION.cff THIRD_PARTY_NOTICES.md
recursive-include licenses *
include MODEL_CARD.md DATA_CARD.md REPRODUCIBILITY.md TRAINING.md
include CHANGELOG.md CONTRIBUTING.md SECURITY.md
include requirements.txt requirements-validated.txt pytest.ini Dockerfile
include .dockerignore .gitignore .gitattributes start_windows.bat start_linux.sh
recursive-include .github *
recursive-include docs *
recursive-include examples *
recursive-include results *
recursive-include schemas *
recursive-include scripts *.py
recursive-include static *
recursive-include templates *.html
recursive-include tests *.py
include weights/manifest.json weights/cold_start_manifest.json weights/README.md
exclude weights/*.pth weights/*.pt weights/*.ckpt weights/*.bin
global-exclude __pycache__ *.py[cod] .DS_Store Thumbs.db
